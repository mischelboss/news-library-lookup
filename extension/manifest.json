{
  "manifest_version": 3,
  "name": "News Library Lookup",
  "version": "0.4.0",
  "description": "Checks paid Spiegel and Tagesspiegel homepage articles in your signed-in VÖBB Genios session.",
  "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"},
  "permissions": ["storage"],
  "host_permissions": ["https://bib-voebb.genios.de/*"],
  "background": {"scripts": ["matching.js", "publishers.js", "background.js"]},
  "content_scripts": [{"matches": ["https://www.spiegel.de/*", "https://www.tagesspiegel.de/*"], "js": ["publishers.js", "content.js"], "run_at": "document_idle"}],
  "action": {"default_title": "News Library Lookup", "default_popup": "popup.html", "default_icon": "icons/icon.svg"},
  "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' https://bib-voebb.genios.de; object-src 'none'; base-uri 'none'"},
  "browser_specific_settings": {"gecko": {
    "id": "@news-library-lookup",
    "strict_min_version": "140.0",
    "data_collection_permissions": {"required": ["websiteContent"]}
  }}
}
